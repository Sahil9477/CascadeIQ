# Copy to .env — never commit .env
AKAMAI_BASE_URL=https://api.akamai-inference.com/v1
AKAMAI_API_KEY=
CHAT_MODEL=qwen3-8-27b

# Linode Personal Access Token (Cloud Manager → Identity → API Tokens)
# Required for API provisioning of Managed Postgres. Types catalog often works without it.
LINODE_TOKEN=

# Managed Postgres us-sea (~$0.58/day smallest 1-node). Fill after create.
# Use either DATABASE_URL or the PG* fields (DATABASE_URL preferred when both set).
DATABASE_URL=
PGHOST=
PGPORT=12381
PGUSER=akmadmin
PGPASSWORD=
PGDATABASE=defaultdb
PGSSLMODE=require
